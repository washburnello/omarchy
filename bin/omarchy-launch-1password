#!/bin/bash

# omarchy:summary=Launch 1Password or start its installer when missing.

set -e

# 1Password is an Electron app that reads the display scale itself and lands on
# an oversized window on scaled monitors. Pin it to 1 and let the compositor do
# the scaling, the same as every other window.
if omarchy-cmd-present 1password; then
  exec setsid uwsm-app -- 1password --force-device-scale-factor=1 "$@"
else
  exec omarchy-launch-floating-terminal-with-presentation omarchy-install-service-1password
fi
